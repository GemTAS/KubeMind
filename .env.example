#Environment Variables — KubeMind

# Database 
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kubemind
POSTGRES_USER=kubemind
POSTGRES_PASSWORD=changeme

# Redis (Optional — caching & metrics buffer) 
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

#Backend 
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=info

# Frontend 
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Kubernetes 
KUBECONFIG=~/.kube/config
